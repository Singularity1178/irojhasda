# Python
__pycache__/
*.py[cod]
*.egg-info/
# Virtual environments (regenerable - recreate with `python -m venv venv`)
.venv/
venv/
.env/
# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# Logs / temp
*.log
_diag_*.tmp
# Scratch 3D models are large binaries - skip any new ones dropped anywhere else.
# Everything the app actually loads lives in model/, so those are tracked; the blanket
# rule used to hide them too, which only made sense while the models were still being
# shuffled between the root and the folder.
*.glb
!model/*.glb
# Written by the app at runtime (window positions, toggles); regenerated on first run
multi_single_screen_pet_ba_settings.json
battle_arena_settings.json
